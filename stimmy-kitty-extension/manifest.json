{
  "manifest_version": 3,
  "name": "Stimmy Kitty",
  "version": "1.0.0",
  "description": "A playful kitty popup with stim sparkle mode and AI search powered by a secure Vercel backend.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://*.vercel.app/*"
  ]
}
